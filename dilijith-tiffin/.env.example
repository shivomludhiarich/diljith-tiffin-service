# Server only. Never put secrets in VITE_* variables.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=dilijith_tiffin
JWT_SECRET=
# Local development; production requires the exact HTTPS website origin, no trailing slash.
ALLOWED_ORIGIN=http://localhost:5173
# Public frontend configuration; default /api. Vite proxies this locally.
VITE_API_URL=/api
VITE_WHATSAPP_NUMBER=
# Only used by the explicit seed:dev command against an empty development database.
ENABLE_DEMO_SEED=false
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# Random server-only secret, at least 32 characters, for automatic meal processing.
CRON_SECRET=

# Gmail signup verification: use a Google App Password, never a normal password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
