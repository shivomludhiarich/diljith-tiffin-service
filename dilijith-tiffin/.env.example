# ==========================================
# Backend Configuration (Node / Express)
# ==========================================
PORT=5000
# MongoDB connection URI (Atlas or Local):
# Atlas example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dilijith_tiffin
# Local example: mongodb://localhost:27017/dilijith_tiffin
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dilijith_tiffin
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
VITE_API_URL=http://localhost:5000/api
# The service's WhatsApp number: country code + number, digits only (e.g. 919876543210).
# Leave empty until the real number exists. No WhatsApp link is generated while it is empty.
VITE_WHATSAPP_NUMBER=
