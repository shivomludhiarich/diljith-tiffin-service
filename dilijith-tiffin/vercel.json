{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/consume-meals",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/consume-meals",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/consume-meals",
      "schedule": "30 15 * * *"
    }
  ]
}
